      <rdf:Description rdf:about=""
            xmlns:xmp="http://ns.adobe.com/xap/1.0/">
         <xmp:CreateDate>2016-05-09T20:45:03+02:00</xmp:CreateDate>
         <xmp:ModifyDate>2016-05-09T20:50:58+02:00</xmp:ModifyDate>
         <xmp:MetadataDate>2016-05-09T20:50:58+02:00</xmp:MetadataDate>
      </rdf:Description>
